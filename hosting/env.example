# Example only. Prefer tools/hosting.py configure for matching random DB credentials.
DJANGO_SETTINGS_MODULE=config.settings.cloudflare_origin
DJANGO_SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_SECRET
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://carrent_tn:REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD@db:5432/carrent_tn
CACHE_URL=redis://redis:6379/1
CORS_ALLOWED_ORIGINS=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=CarRent TN <noreply@example.com>
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
