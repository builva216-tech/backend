DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=carrent-blitz.builva.blitz.cloud,app-carrent-blitz.u-builva.svc.cluster.local
CSRF_TRUSTED_ORIGINS=https://carrent-blitz.builva.blitz.cloud
CORS_ALLOWED_ORIGINS=
WEB_CONCURRENCY=1
R2_ENABLED=false
DURABLE_UPLOADS_ENABLED=true
FCM_ENABLED=false
# Blitz supplies DATABASE_URL when you connect PostgreSQL. Do not use localhost.
# EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD,
# EMAIL_USE_TLS, DEFAULT_FROM_EMAIL: configure your actual SMTP provider.
# CACHE_URL: use a shared Redis cache before adding multiple web workers.
